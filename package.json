{
  "name": "knowledgecore",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && prisma migrate deploy && NEXT_DIST_DIR=.next-build next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d postgres qdrant",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d postgres qdrant",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "smoke": "bun run scripts/smoke.ts",
    "verify:path-confirmation": "bun run scripts/verify-path-confirmation.ts",
    "verify:stt": "bun run scripts/verify-stt.ts",
    "verify:visual-media": "bun run scripts/verify-visual-media.ts",
    "verify:landing-flow": "bun run scripts/verify-landing-flow.ts",
    "verify:research-bundle": "bun run scripts/verify-research-bundle.ts",
    "cleanup:guests": "bun run scripts/cleanup-guests.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.0",
    "@emotion/cache": "^11.13.5",
    "@emotion/react": "^11.13.5",
    "@emotion/styled": "^11.13.5",
    "@google/genai": "^0.7.0",
    "@mui/material": "^6.3.0",
    "@mui/material-nextjs": "^6.3.0",
    "@prisma/client": "^6.2.0",
    "@qdrant/js-client-rest": "^1.12.0",
    "better-auth": "^1.6.12",
    "katex": "^0.17.0",
    "next": "^15.1.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "prisma": "^6.2.0",
    "typescript": "^5.7.2"
  }
}
