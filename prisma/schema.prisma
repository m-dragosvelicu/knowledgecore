datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// =====================================================================
// Better Auth models
// =====================================================================
// Shapes are authoritative per Better Auth (better-auth@1.6.x) with two local
// additions: `@default(cuid())` on ids (so existing User.id values stay valid and
// LearningIntent.userId FKs survive) and the `learningIntents` relation
// back-reference. `name` is kept optional to tolerate accounts created without a
// display name. Tables are lowercased via `@@map` to match Better Auth defaults.

model User {
  id              String           @id @default(cuid())
  name            String?
  email           String           @unique
  emailVerified   Boolean          @default(false)
  image           String?
  // Better Auth anonymous plugin flag. A guest session is a real User row with
  // isAnonymous=true (see lib/auth.ts). The whole pre-journey flow keys to a
  // userId, so a guest is a first-class owner; the create-account gate and the
  // onLinkAccount claim re-own the journey when the guest signs up / in.
  isAnonymous     Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  sessions        Session[]
  accounts        Account[]
  learningIntents LearningIntent[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// =====================================================================
// L0 — Learning Mechanic models
// =====================================================================

enum JourneyStatus {
  created
  goal_assessed
  outcome_assessed
  knowledge_assessed
  path_outlined
  in_progress
  paused
  complete
  abandoned
}

enum Motivation {
  curiosity
  fun
  school
  work
  other
}

enum GoalpostStatus {
  pending
  in_progress
  complete
  skipped
}

enum StepType {
  information
  experience_socratic
  experience_applied_problem
  experience_mini_project
}

enum Decision {
  advance
  repeat
  adjust_plan
}

/// L0 §4 `LearningPath.status` — tracks lifecycle of the generated path independently of
/// `LearningIntent.status`. Wizard transitions: `draft` (just generated) -> `accepted`
/// (user confirmed) -> `in_progress` (first goalpost started) -> `complete` / `abandoned`.
enum PathStatus {
  draft
  accepted
  in_progress
  complete
  abandoned
}

/// L0 §9 — purpose of an LLM call, used for cost-cap accounting and observability.
/// Mirrors the service call sites in `lib/services/*` plus an `other` bucket
/// for ad-hoc utility calls (e.g. summarisation outside the wizard).
enum LlmCallPurpose {
  intent_parse
  goal_interview
  knowledge_probe_questions
  knowledge_probe_score
  path_outline
  checkpoint_evaluate
  // L1 — the Path Adjuster's adjust_plan revision call. Closes the documented
  // L0 stopgap where LivePathAdjuster logged its call under `other` for lack of
  // a dedicated value.
  path_adjust
  // L1 Slice 1 — Call B: per-goalpost lesson-content generation with the learner
  // profile injected. The lazy half of the split generation (Call A = path_outline).
  lesson_content
  // L1 Slice 3 — speech-to-text: a Gemini AUDIO (multimodal) transcription call.
  // Recorded learner speech in, clean transcript out. The audio is discarded after
  // transcription (never persisted); only this telemetry row + the transcript live on.
  stt_transcribe
  // L1 Slice 4 — visual media: the content-generating LLM call that emits a
  // diagram-type visual as SVG code (the visualKind=diagram route of the gate).
  // Closes the documented enum debt; the SVG is sanitized on its own dedicated
  // render path before display (never the markdown sanitizer).
  visual_generate
  other
}

model LearningIntent {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  rawText   String
  status    JourneyStatus @default(created)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  subject    Subject?
  goal       LearningGoal?
  outcome    ExpectedOutcome?
  assessment KnowledgeAssessment?
  path       LearningPath?
  profile    LearnerProfile?

  // L2 — the research bundle(s) this journey draws provenance from. M:N via
  // JourneyBundleLink so the SAME topic bundle is reused across users (Library reuse).
  bundles JourneyBundleLink[]

  @@index([userId, status])
}

model Subject {
  id            String         @id @default(cuid())
  intentId      String         @unique
  intent        LearningIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)
  canonicalName String
  scopeNote     String
}

model LearningGoal {
  id          String         @id @default(cuid())
  intentId    String         @unique
  intent      LearningIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)
  motivation  Motivation
  elaboration String
  /// Raw user input for the time horizon (e.g. "a couple of weeks").
  timeHorizon String?
  /// L0 §4 — numeric horizon parsed from `timeHorizon`; feeds §9 path-budget constraint.
  /// Distinct from `timeHorizon` which stays the unparsed user phrasing.
  timeHorizonDays Int?
  /// L0 §4 — user-provided constraints (e.g. deadlines, prerequisites to skip).
  externalConstraints String?
  /// Resume support — the running goal-interview transcript, a JSON array of
  /// `{ role: "assistant" | "user"; content: string }`. Persisted progressively
  /// each turn so a learner who saves & leaves mid-outcome returns to the exact
  /// point in the conversation instead of restarting at the motivation question.
  interviewTranscript Json?
  /// Resume support — the synthesized but not-yet-confirmed outcome from the end
  /// of the interview: `{ canDoStatements: {text, bloomLevel}[]; successCriterion }`.
  /// Written when the interview reaches "complete"; lets resume land on the
  /// confirm-outcome screen rather than restarting. Cleared/superseded once the
  /// learner confirms (finalizeOutcomeAction writes the authoritative ExpectedOutcome).
  draftOutcome Json?
}

/// `canDoStatements` is a JSON array of `{ text: string; bloomLevel: string }`
model ExpectedOutcome {
  id              String         @id @default(cuid())
  intentId        String         @unique
  intent          LearningIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)
  canDoStatements Json
  /// L0 §4 — LLM-generated summary of what success looks like for this outcome.
  successCriterion String?
}

/// `competencies` is a JSON array of `{ competency: string; estimatedLevel: 0..4; confidence: 0..1 }`
model KnowledgeAssessment {
  id           String         @id @default(cuid())
  intentId     String         @unique
  intent       LearningIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)
  competencies Json
  /// L0 §4 — audit trail for probe scoring: array of
  /// `{ question: string; answer: string; judgement: string }`.
  probeTranscript Json?
  /// L0 §4 — `string[]` appended when §7 checkpoints reveal the initial estimate was off.
  recalibrationFlags Json?
}

model LearningPath {
  id            String         @id @default(cuid())
  intentId      String         @unique
  intent        LearningIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)
  acceptedAt    DateTime?
  /// L0 §4 — explicit lifecycle status; previously inferred from `LearningIntent.status`.
  status        PathStatus     @default(draft)
  /// L0 §4 — counts how many times §7 calibration loop produced a `PathRevision`.
  revisionCount Int            @default(0)
  goalposts     Goalpost[]
  revisions     PathRevision[]
}

model Goalpost {
  id               String                 @id @default(cuid())
  pathId           String
  path             LearningPath           @relation(fields: [pathId], references: [id], onDelete: Cascade)
  order            Int
  title            String
  objective        String
  estimatedMinutes Int
  status           GoalpostStatus         @default(pending)
  steps            Step[]
  evaluations      CheckpointEvaluation[]

  @@unique([pathId, order])
  @@index([pathId, status])
}

/// `payload` shape varies by `type`:
/// - `information`: `{ content: string; sourceIds?: string[] }`
/// - `experience_*`: `{ prompt: string; rubricFocus?: string[] }`
model Step {
  id           String    @id @default(cuid())
  goalpostId   String
  goalpost     Goalpost  @relation(fields: [goalpostId], references: [id], onDelete: Cascade)
  order        Int
  type         StepType
  payload      Json
  userArtifact String?
  completedAt  DateTime?
  /// L0 §4 — JsonSchema for the experience artifact. Optional/forward-looking: L0 ships a
  /// plain textarea baseline (B.6 Q2), so structured artifact capture comes later.
  expectedArtifactSchema Json?

  @@unique([goalpostId, order])
}

/// `scores` is `{ recall, application, conceptual, transfer, communication, coverage }: 0..4`.
/// `evidence` is an array of `{ dimension: string; quote: string }`.
model CheckpointEvaluation {
  id         String   @id @default(cuid())
  goalpostId String
  goalpost   Goalpost @relation(fields: [goalpostId], references: [id], onDelete: Cascade)
  attempt    Int
  scores     Json
  evidence   Json
  decision   Decision
  rationale  String
  createdAt  DateTime @default(now())
  /// L0 §4 — when the user overrides the model's decision (e.g. forces `advance` despite
  /// `repeat`). NULL means no override. Captured for §7 calibration loop and thesis claims
  /// about agency. Free-text rationale optional but recommended.
  userOverride Json?
  llmCalls   LlmCall[]

  triggeredRevision PathRevision?

  @@unique([goalpostId, attempt])
}

/// `changes` records the diff applied to remaining goalposts.
model PathRevision {
  id              String                @id @default(cuid())
  pathId          String
  path            LearningPath          @relation(fields: [pathId], references: [id], onDelete: Cascade)
  triggerEvalId   String?               @unique
  triggerEval     CheckpointEvaluation? @relation(fields: [triggerEvalId], references: [id], onDelete: SetNull)
  changes         Json
  createdAt       DateTime              @default(now())
}

/// Per-call LLM telemetry. Written as a side effect by every live service implementation
/// (see `lib/services/`). Required for L0 §9.7 cost caps and thesis-defence claims about
/// model behaviour. The optional FK to `CheckpointEvaluation` lets us attribute spend
/// when the call belongs to a checkpoint; non-evaluator calls leave it NULL.
///
/// `request` and `response` are kept opaque (Json) to avoid coupling to any one SDK
/// shape; the live impl decides what subset to persist (prompt, tool calls, system
/// fingerprint, etc.). Truncate large payloads before persisting if needed.
model LlmCall {
  id           String         @id @default(cuid())
  createdAt    DateTime       @default(now())
  purpose      LlmCallPurpose
  /// Model identifier as reported by the provider (e.g. `claude-opus-4-7`,
  /// `gemini-2.5-pro`). Free-text to avoid an enum churn every model release.
  model        String
  inputTokens  Int
  outputTokens Int
  /// USD cost estimate computed from the live pricing table at request time.
  /// Stored as decimal microdollars (i.e. multiply USD by 1_000_000) to avoid
  /// float drift; consumers divide for display.
  costMicroUsd Int
  latencyMs    Int
  success      Boolean
  errorMessage String?
  /// Optional opaque payloads — see model docstring.
  request      Json?
  response     Json?

  evaluationId String?
  evaluation   CheckpointEvaluation? @relation(fields: [evaluationId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([purpose, createdAt])
  @@index([evaluationId])
}

// =====================================================================
// L1 — Learner Profile (adaptive spine, Slice 1)
// =====================================================================
// Adopted design: CEO/L1-learner-profile-representation.html (decided 2026-05-31).
// The profile is a STRUCTURED, MEASURABLE record (never a freeform model note):
//   1. a per-concept mastery core, updated by a transparent BKT-style rule with
//      fixed, documented parameters (see lib/journey/learnerProfile.ts), and
//   2. a small TYPED signal vector for things mastery does not capture.
// Every update writes a new immutable LearnerProfileSnapshot row (append-only);
// the live LearnerProfile holds only the current read. The snapshots are the
// thesis evidence artifact: they let us show the model sharpening over a journey.

/// L1 — the journey-level learner profile feeding generation (Call B) and the
/// render-only presenter seam. ONE per journey, keyed 1:1 to `LearningIntent`
/// (mirrors Subject / LearningGoal / ExpectedOutcome / KnowledgeAssessment /
/// LearningPath). It is journey-scoped and RESETS per journey: a new learning
/// intent starts a fresh profile, so confident-in-Python never smears over
/// anxious-in-statistics.
///
/// CROSS-JOURNEY EXTENSION POINT (L4, deferred — build NO aggregation now):
/// a future person-level aggregation step would read these journey-level rows
/// (and their snapshots) across a user's intents to derive durable, cross-subject
/// dispositions. The `userId` denormalisation below exists ONLY to make that
/// future read cheap (query all profiles for a user without joining through
/// LearningIntent). No aggregation logic is implemented in L1.
model LearnerProfile {
  id       String         @id @default(cuid())
  intentId String         @unique
  intent   LearningIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)

  /// Denormalised owner id. NOT used for adaptation in L1; present purely as the
  /// L4 cross-journey aggregation extension point (read all of a user's profiles
  /// without a join). See model docstring.
  userId String

  /// MASTERY CORE — per-concept mastery estimates, the BKT-style rule's state.
  /// Map keyed by a stable concept key (e.g. a goalpost id or competency name) to
  /// `{ mastery: number 0..1; observations: number; lastUpdatedAt: ISO8601 }`.
  /// `mastery` is P(learner has mastered this concept). Updated transparently by
  /// `applyBktUpdate` in lib/journey/learnerProfile.ts — NOT a fitted model.
  conceptMastery Json @default("{}")

  // --- TYPED SIGNAL VECTOR (what the mastery core does not capture) ----------
  // Exactly the four signals L0 already produces (the two cut onboarding
  // micro-questions are deliberately absent — see the adopted decision).

  /// Latest Paas perceived-mental-effort rating (1..9), tapped after an
  /// experience. NULL until the first rating. Informs pace / worked-example density.
  latestPaasEffort Int?

  /// Running count of repeat attempts across the journey's goalposts. Informs
  /// support level and struggle detection.
  totalRetries Int @default(0)

  /// Cumulative time-on-task in milliseconds across steps. Informs pace and
  /// struggle detection.
  totalTimeOnTaskMs Int @default(0)

  /// How often the learner flagged a visual as "not helpful". Informs whether to
  /// keep offering that visual treatment.
  visualNotHelpfulCount Int @default(0)

  /// EVOLVING / INFERRED signals bag (matches the schema's Json convention, e.g.
  /// competencies / recalibrationFlags). Holds model-derived-but-still-STRUCTURED
  /// reads whose shape evolves during L1 without a migration each time, e.g.
  /// `{ readingLevel?: string; expertiseBand?: "novice"|"developing"|"proficient";
  ///    lastInferredAt?: ISO8601 }`. Never a freeform paragraph (anti-drift).
  derivedSignals Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  snapshots LearnerProfileSnapshot[]

  @@index([userId])
}

/// L1 — APPEND-ONLY immutable snapshot of a LearnerProfile, written on EVERY
/// profile update. Never overwritten, never deleted in normal operation. This is
/// the headline empirical artifact: replaying these rows in `seq` order shows the
/// learner model sharpening concept-by-concept as evidence accumulates.
///
/// Each row is a self-contained copy of the profile state AFTER the update, plus
/// a record of the evidence that triggered it, so the snapshot stream is auditable
/// and replayable on its own without reconstructing from the live row.
model LearnerProfileSnapshot {
  id        String         @id @default(cuid())
  profileId String
  profile   LearnerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  /// Monotonic per-profile sequence number (1-based). Unique per profile so the
  /// snapshot stream has a stable, gap-checkable order independent of timestamps.
  seq Int

  /// Why this snapshot was written: the kind of evidence that triggered the
  /// update (e.g. "checkpoint_result", "retry", "paas_effort", "time_on_task",
  /// "visual_not_helpful", "init"). Free-text to avoid enum churn during L1.
  reason String

  /// Optional structured detail of the triggering evidence (e.g. the concept key,
  /// the checkpoint correctness, the prior/posterior mastery). Opaque Json for
  /// audit; the writer decides the shape.
  evidence Json?

  // --- Frozen copy of the profile state AFTER this update --------------------
  conceptMastery        Json
  latestPaasEffort      Int?
  totalRetries          Int
  totalTimeOnTaskMs     Int
  visualNotHelpfulCount Int
  derivedSignals        Json?

  createdAt DateTime @default(now())

  @@unique([profileId, seq])
  @@index([profileId, createdAt])
}

// =====================================================================
// L2 — Research Agent, Provenance & the Library
//
// All ADDITIVE (no existing column changes; the LearningIntent.bundles
// back-relation above is the only edit to the existing aggregate). Postgres is
// the authoritative record of every Source / bundle; Qdrant (later phase) is a
// derived, rebuildable index. See docs/l2/research/backend-engineer.md §3.
// =====================================================================

enum SourceKind {
  academic // OpenAlex / Semantic Scholar work (has DOI)
  web      // Tavily / Firecrawl page (official docs, vendor sites)
}

enum SourceStatus {
  fetched // metadata + text retrieved
  failed  // upstream error; kept for audit, not used for grounding
}

enum BundleStatus {
  researching // Research Agent running; sources being filled
  ready       // usable for grounding
  failed      // research failed; journey falls back to ungrounded generation
}

/// A globally-deduped citable source. Owned by NO user — shared across bundles
/// and journeys. Dedup key is the natural global identity (DOI -> canonical URL
/// -> sha256(text)).
model Source {
  id     String       @id @default(cuid())
  kind   SourceKind
  status SourceStatus @default(fetched)

  /// Global dedup key. DOI when present, else canonicalized URL, else sha256(text).
  /// UNIQUE: the same paper/page is one row no matter how many bundles reference it.
  dedupKey String @unique

  /// First-class provenance fields (ADR 9 — OpenAlex gives these structured).
  doi           String?
  canonicalUrl  String?
  title         String
  authors       Json?
  venue         String?
  publishedYear Int?
  retrievedAt   DateTime @default(now())

  /// Normalized full text / extracted content kept for re-chunk / re-embed.
  rawText String? @db.Text

  chunks      SourceChunk[]
  bundleLinks BundleSourceLink[]

  createdAt DateTime @default(now())

  @@index([kind, status])
  @@index([doi])
}

/// The unit that gets embedded and retrieved. Content-addressed so re-embedding
/// is a no-op. The vector itself lives in Qdrant (later phase), not here — this
/// row is the relational anchor Qdrant payloads point back to.
model SourceChunk {
  id       String @id @default(cuid())
  sourceId String
  source   Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  ordinal Int    // position within the source
  text    String @db.Text

  /// sha256(sourceId + normalizedText). Re-chunking the same content is idempotent.
  contentHash String @unique

  /// Mirror flag: set once the vector is upserted into Qdrant. NULL = pending.
  embeddedAt DateTime?

  createdAt DateTime @default(now())

  @@index([sourceId, ordinal])
}

/// "Core source material bundle" for ONE topic. Owned by no user. Reused across
/// journeys/users via BundleSourceLink + JourneyBundleLink. Content-addressed by topic.
model ResearchBundle {
  id String @id @default(cuid())

  /// Deterministic hash of the canonical topic (see lib/research/fingerprint.ts).
  /// UNIQUE so concurrent path-confirms for the same topic converge on one
  /// bundle (DB-enforced idempotency / read-through cache).
  topicFingerprint String @unique

  /// Human-readable echo of what was fingerprinted (debug / Library browse).
  topicLabel String
  status     BundleStatus @default(researching)

  /// Embedding model id + dimension this bundle's vectors were built with (set in
  /// a later phase when embeddings land; null in Phase 0).
  embeddingModel String?
  embeddingDim   Int?

  /// L2-extensibility toward a public/shared Library (founder: "becomes public
  /// later"). Default false in L2; flipping it later needs no schema change.
  isPublic Boolean @default(false)

  sources    BundleSourceLink[]
  journeys   JourneyBundleLink[]
  amendments BundleAmendment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

/// M:N join — a source can belong to many bundles (global dedup), a bundle has
/// many sources. Each row is a single bundle<->source link (see ...Link suffix).
model BundleSourceLink {
  bundleId String
  bundle   ResearchBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  sourceId String
  source   Source         @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  /// Why this source is in this bundle (which goalpost/objective it grounds).
  scopeNote String?
  addedAt   DateTime @default(now())

  @@id([bundleId, sourceId])
  @@index([sourceId])
}

/// M:N — binds a journey to the bundle(s) it draws provenance from. THIS is the
/// reuse seam: two users on the same topic both point at one ResearchBundle.
/// Each row is a single journey<->bundle link (see ...Link suffix).
model JourneyBundleLink {
  intentId String
  intent   LearningIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)
  bundleId String
  bundle   ResearchBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  boundAt  DateTime       @default(now())

  @@id([intentId, bundleId])
  @@index([bundleId])
}

/// A targeted re-trigger of the Research Agent because a GAP was found (later
/// phase). Records the gap and what was added so the bundle grows MONOTONICALLY
/// and the re-trigger is auditable + idempotent.
model BundleAmendment {
  id       String         @id @default(cuid())
  bundleId String
  bundle   ResearchBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  /// What was missing (free-text or structured gap descriptor).
  gap String
  /// Optional pointer to the goalpost whose generation surfaced the gap.
  goalpostId String?

  /// Source ids added by this amendment (audit: the bundle diff).
  addedSourceIds Json     @default("[]")
  createdAt      DateTime @default(now())

  @@index([bundleId, createdAt])
}
