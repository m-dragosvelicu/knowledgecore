# --- Database ---
# Postgres connection string. Local docker-compose runs on host port 5440.
DATABASE_URL="postgresql://knowledgecore:knowledgecore@localhost:5440/knowledgecore?schema=public"

# --- Vector DB ---
# Qdrant local: see docker-compose.yml. Port 6433 is the HTTP API; 6434 is gRPC.
# API key is optional locally; required for any hosted Qdrant deployment.
QDRANT_URL="http://localhost:6433"
QDRANT_API_KEY=""

# --- Auth.js (v5) ---
# Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=""
# AUTH_TRUST_HOST must be "true" on Vercel / behind any reverse proxy.
AUTH_TRUST_HOST="true"

# Demo-mode credentials provider. When "true", any email can sign in without
# verification (impersonation-capable — see SETUP.md). Required for the thesis
# demo URL; never set in a real production environment.
ALLOW_DEMO_AUTH="false"

# Google OAuth — create at https://console.cloud.google.com/apis/credentials .
# Authorized redirect URI: <origin>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- LLM providers ---
# Anthropic — required for any live service in lib/services/. Without it the
# registry stays on mocks (see lib/services/index.ts).
ANTHROPIC_API_KEY=""
# Google GenAI — used for the multimodal evaluator path (L0 §5).
GOOGLE_GENAI_API_KEY=""
# Paralon — experimental third LLM provider (see lib/llm/paralon.ts). Status
# pending CEO confirmation; safe to leave blank.
PARALON_API_KEY=""

# --- Live-service per-service opt-in flags ---
# Each flag enables the live implementation for one service, gated on
# ANTHROPIC_API_KEY being set. Default unset / "false" = mock. Flip individually
# during partial rollouts (e.g. CheckpointEvaluator first, others later).
LIVE_INTENT_PARSER="false"
LIVE_GOAL_INTERVIEWER="false"
LIVE_KNOWLEDGE_PROBE="false"
LIVE_PATH_OUTLINER="false"
LIVE_CHECKPOINT_EVALUATOR="false"

# --- Research APIs ---
# OpenAlex polite-pool email (no key required, but providing email gives faster pool).
OPENALEX_EMAIL=""

# Semantic Scholar (optional, increases rate limit).
SEMANTIC_SCHOLAR_API_KEY=""

# Tavily (https://tavily.com — generic web search fallback).
TAVILY_API_KEY=""

# Firecrawl (https://firecrawl.dev — web scraping/extraction fallback).
FIRECRAWL_API_KEY=""
